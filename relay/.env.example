# Copy to .env for local runs, or set these as environment variables on your host.
# NEVER commit the real .env file.

# Long random string; must match the "secret" field in your TradingView alert message.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=CHANGE_ME

# Webot/Pionex API credentials — create a TRADE-ONLY key (no withdrawal permission).
PIONEX_API_KEY=
PIONEX_API_SECRET=

# Safety switches
LIVE_TRADING=false        # keep false until check_setup.py passes and a dry-run test looks right
MAX_ORDER_USD=100         # hard cap per buy order
DEFAULT_AMOUNT_USD=25     # used when the alert doesn't specify amount_usd

# Advanced
# PIONEX_BASE_URL=https://api.pionex.com
# DB_PATH=relay.db
