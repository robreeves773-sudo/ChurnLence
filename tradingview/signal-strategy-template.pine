//@version=6
// Starter strategy template for driving a Webot/Pionex Signal Bot from
// TradingView webhook alerts.
//
// How to use:
//   1. Paste into TradingView's Pine Editor and "Add to chart".
//   2. Replace the example EMA-cross logic with your own entry/exit rules.
//   3. Backtest in the Strategy Tester before automating anything.
//   4. Create an alert on this strategy: condition = "Order fills only",
//      enable Webhook URL (paid-plan feature), paste the URL from
//      Webot/Pionex Signal Bot, and put that bot's Message template in the
//      alert message box. Prefer the official "Pionex Signal Bot
//      (Single/Multi Position)" strategy by Jon_Pionex if it is available —
//      it emits the exact payload the bot expects.
//
// This template is educational and not financial advice. Test with small size.

strategy("Webot Signal Starter", overlay = true,
     initial_capital = 1000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 10,
     commission_type = strategy.commission.percent,
     commission_value = 0.1)   // ~Webot maker fee, so backtests include costs

// ---- Example logic: EMA cross (replace with your strategy) ----
fastLen = input.int(21, "Fast EMA")
slowLen = input.int(55, "Slow EMA")

fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)

plot(fastEma, "Fast EMA", color = color.teal)
plot(slowEma, "Slow EMA", color = color.orange)

longSignal  = ta.crossover(fastEma, slowEma)
exitSignal  = ta.crossunder(fastEma, slowEma)

// ---- Orders (spot-style: long entries and flat exits only) ----
if longSignal
    strategy.entry("Long", strategy.long)
if exitSignal
    strategy.close("Long")

// Optional protective stop, percent-based
useStop = input.bool(true, "Use stop loss")
stopPct = input.float(5.0, "Stop loss %", minval = 0.1, step = 0.1)
if useStop
    strategy.exit("Stop", from_entry = "Long", loss_percent = stopPct)
